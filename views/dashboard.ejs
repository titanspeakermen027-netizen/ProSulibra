<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0b1020">
  <title><%= config.botName %> • Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-left">
      <a class="brand" href="/"><span class="brand-mark">✦</span><span><%= config.botName %><small>Discord Bot Dashboard</small></span></a>
      <div class="server-picker" id="server-picker">اختار سيرفر <span>⌄</span></div>
    </div>
    <div class="user">
      <button class="icon-btn" type="button" title="الوضع الداكن">◐</button>
      <a class="user-name" href="/api/me"><span><%= user.global_name || user.username %></span><small>Owner</small></a>
      <% if (user.avatar) { %><img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=96" alt="avatar" onerror="this.style.display='none'"> <% } %>
      <a class="logout" href="/auth/logout">خروج</a>
    </div>
  </header>

  <main class="dashboard-shell">
    <aside class="sidebar">
      <div class="sidebar-server"><span class="mini-server-icon">◈</span><span id="sidebar-server-name">السيرفر</span><span class="chev">⌄</span></div>
      <nav class="nav-menu">
        <a href="#top" class="nav-link"><span>⌂</span> لوحة التحكم</a>
        <a href="#general" class="nav-link"><span>⚙</span> الإعدادات العامة</a>
        <div class="nav-group active">
          <div class="nav-group-title"><span>◉</span> Welcome Card <b>⌃</b></div>
          <a href="#welcome-card" class="nav-link sub active">✦ محرر كارت الترحيب</a>
          <a href="#welcome-message" class="nav-link sub">✦ رسالة الترحيب</a>
          <a href="#leave" class="nav-link sub">✦ رسالة المغادرة</a>
          <a href="#auto-role" class="nav-link sub">✦ الرتب التلقائية</a>
        </div>
        <a href="#manage" class="nav-link"><span>▣</span> إدارة السيرفر <b>›</b></a>
        <a href="#stats" class="nav-link"><span>▥</span> الإحصائيات <b>›</b></a>
        <a href="#logs" class="nav-link"><span>▤</span> السجلات <b>›</b></a>
        <a href="#bot" class="nav-link"><span>⚙</span> إعدادات البوت <b>›</b></a>
      </nav>
      <div class="bot-status"><span class="online-dot"></span><div><b>البوت يعمل بشكل طبيعي</b><small>● Online</small></div></div>
      <div class="version">◈ <span>ProSulibra v1.0.0</span></div>
    </aside>

    <section class="content" id="top">
      <div id="empty" class="empty-state panel">
        <div class="empty-icon">◉</div>
        <h1>Welcome Dashboard</h1>
        <p>اختار سيرفر من القائمة باش تفتح محرر الترحيب الاحترافي.</p>
      </div>
      <div id="editor" class="hidden"></div>
    </section>
  </main>

<script>
const csrf = <%- JSON.stringify(csrf) %>;
let selected = null, currentGuild = null, backgroundData = null;
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const bool = v => v === true || v === 1 || v === '1' || v === 'true';
async function json(url, opts={}) { const r=await fetch(url,opts); const d=await r.json().catch(()=>({})); if(!r.ok) throw new Error(d.error||'request_failed'); return d; }

const presetMap = {
  midnight: 'linear-gradient(135deg,#071224 0%,#0b1834 42%,#321b77 100%)',
  ocean: 'linear-gradient(135deg,#041825 0%,#075985 48%,#2563eb 100%)',
  purple: 'linear-gradient(135deg,#160b2a 0%,#4c1d95 50%,#a855f7 100%)',
  crimson: 'linear-gradient(135deg,#210708 0%,#7f1d1d 50%,#dc2626 100%)',
  forest: 'linear-gradient(135deg,#031a13 0%,#14532d 50%,#16a34a 100%)'
};

async function loadGuilds(){
  try {
    const list=await json('/api/guilds');
    $('#guilds').innerHTML=list.length ? list.map(g=>`<button class="guild ${selected===g.id?'active':''}" data-id="${g.id}"><span class="guild-icon">${g.icon?`<img src="https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png?size=96" alt="">`:(g.name[0]||'?')}</span><span class="guild-copy"><b>${esc(g.name)}</b><small>${g.botPresent?'متاح للتخصيص':'البوت مازال ما دخلش'}</small></span>${g.botPresent?'<span class="guild-ok">✓</span>':'<span class="guild-warn">!</span>'}</button>`).join(''):'<div class="muted">ما عندك حتى سيرفر قابل للإدارة.</div>';
    document.querySelectorAll('.guild').forEach(b=>b.onclick=()=>selectGuild(b.dataset.id));
  } catch(e) { $('#guilds').innerHTML='<div class="muted">جلسة Discord سالات، عاود دخل.</div>'; }
}

function cardStateFromForm(){
  const get=id=>document.getElementById(id);
  if(!get('card_primary_color')) return null;
  return {
    text:get('welcome_card_text').value, sub:get('welcome_card_subtext').value,
    primary:get('card_primary_color').value, secondary:get('card_secondary_color').value,
    textColor:get('card_text_color').value, serverColor:get('card_server_color').value,
    preset:get('card_background_preset').value, shape:get('card_avatar_shape').value,
    avatarSize:Number(get('card_avatar_size').value||230), borderColor:get('card_avatar_border_color').value,
    borderWidth:Number(get('card_avatar_border_width').value||6), overlay:Number(get('card_overlay_opacity').value||35),
    font:get('card_font_family').value, align:get('card_text_align').value, footer:get('card_footer_text').value,
    showMembers:get('card_show_member_count').checked, showServer:get('card_show_server').checked,
    showJoinDate:get('card_show_join_date').checked
  };
}

function renderPreview(){
  const s=cardStateFromForm(); if(!s) return;
  const guild=currentGuild?.guild || {}; const name=(<%= JSON.stringify(user.global_name || user.username) %>) || 'User';
  const server=guild.name || 'Your Server';
  const memberCount=guild.memberCount || 128;
  const avatar='<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=512` : '' %>';
  const bg=backgroundData ? `url("${backgroundData}")` : presetMap[s.preset];
  const align=s.align==='left'?'left':s.align==='right'?'right':'center';
  const avatarRadius=s.shape==='circle'?'50%':s.shape==='rounded'?'24px':'8px';
  const footer=esc((s.footer||'Together We Are Stronger').replace('{server}',server).replace('{username}',name));
  let items='';
  if(s.showServer) items+=`<div class="preview-server" style="color:${s.serverColor}">${esc(server)}</div>`;
  if(s.showMembers) items+=`<div class="preview-stat">👥 عضو رقم ${memberCount}</div>`;
  if(s.showJoinDate) items+=`<div class="preview-date">تاريخ الانضمام: اليوم</div>`;
  $('#card-preview').style.backgroundImage=bg;
  $('#card-preview').style.setProperty('--pc',s.primary); $('#card-preview').style.setProperty('--sc',s.secondary);
  $('#card-preview').innerHTML=`<div class="preview-overlay" style="opacity:${Math.max(0,Math.min(85,s.overlay))/100}"></div><div class="preview-inner" style="text-align:${align}"><div class="preview-avatar-wrap" style="width:${s.avatarSize/2}px;height:${s.avatarSize/2}px;border:${s.borderWidth/2}px solid ${s.borderColor};border-radius:${avatarRadius}"><img src="${avatar||'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="avatar" style="border-radius:${avatarRadius}"></div><div class="preview-title" style="color:${s.textColor};font-family:${esc(s.font)},Arial,sans-serif">${esc((s.text||'WELCOME').replace('{server}',server).replace('{username}',name).replace('{memberCount}',memberCount))}</div><div class="preview-sub" style="color:${s.textColor};font-family:${esc(s.font)},Arial,sans-serif">${esc((s.sub||name).replace('{server}',server).replace('{username}',name).replace('{memberCount}',memberCount))}</div>${items}<div class="preview-line" style="background:${s.primary}"></div><div class="preview-footer" style="color:${s.textColor}">${footer}</div></div>`;
}

function bindLivePreview(){
  document.querySelectorAll('#editor input,#editor textarea,#editor select').forEach(el=>el.addEventListener('input',renderPreview));
  document.querySelectorAll('.preset-btn').forEach(b=>b.onclick=()=>{document.getElementById('card_background_preset').value=b.dataset.preset; backgroundData=null; renderPreview(); document.querySelectorAll('.preset-btn').forEach(x=>x.classList.toggle('selected',x===b));});
  const rangePairs=[['card_avatar_size','avatar_size_value'],['card_avatar_border_width','avatar_border_value'],['card_overlay_opacity','overlay_value']];
  rangePairs.forEach(([a,b])=>{const x=document.getElementById(a);const y=document.getElementById(b);if(x&&y){x.addEventListener('input',()=>y.textContent=x.value+(a==='card_avatar_size'?'px':a==='card_overlay_opacity'?'%':'px'));}});
}

function createEditor(d){
  const s=d.settings, channels=d.guild.channels, roles=d.guild.roles;
  if(!d.guild.botPresent){
    $('#empty').classList.add('hidden'); $('#editor').classList.remove('hidden');
    $('#editor').innerHTML=`<div class="panel missing-bot"><h1>${esc(d.guild.name)}</h1><p>البوت ما داخلش لهاذ السيرفر.</p><a class="primary" href="/api/invite" target="_blank">إضافة البوت للسيرفر</a></div>`; return;
  }
  backgroundData=s.card_background_data || null;
  $('#sidebar-server-name').textContent=d.guild.name;
  $('#server-picker').innerHTML=`<span class="picker-icon">◈</span>${esc(d.guild.name)} <span>⌄</span>`;
  $('#empty').classList.add('hidden'); $('#editor').classList.remove('hidden');
  $('#editor').innerHTML=`
  <div class="page-head" id="welcome-card"><div><div class="eyebrow"><span>◉</span> Welcome Card</div><h1>محرر كارت الترحيب</h1><p>قم بتخصيص بطاقة الترحيب الخاصة بسيرفرك بشكل كامل.</p></div><div class="head-actions"><button id="live" class="secondary">◉ معاينة مباشرة</button><button id="save" class="primary">↻ حفظ التغييرات</button></div></div>
  <div class="editor-layout">
    <div class="settings-column">
      <section class="editor-card" id="welcome-message"><div class="section-header"><div class="section-icon">✎</div><div><h2>نص الترحيب</h2><p>يمكنك استعمال المتغيرات داخل النص.</p></div></div><div class="tokens"><span>{user}</span><span>{username}</span><span>{server}</span><span>{memberCount}</span></div><textarea id="welcome_message" class="big-text">${esc(s.welcome_message)}</textarea><div class="counter">2000 حرف كحد أقصى</div></section>

      <section class="editor-card"><div class="section-header"><div class="section-icon">▧</div><div><h2>الصورة الخلفية</h2><p>اختر صورة مخصصة أو أحد القوالب الجاهزة.</p></div></div><div class="background-tools"><div class="upload-box" id="upload-box"><input id="card_background_file" type="file" accept="image/png,image/jpeg,image/webp" hidden><button type="button" id="upload-btn"><span>↥</span><b>رفع صورة جديدة</b><small>PNG / JPG / WEBP حتى 2MB</small></button><div id="background-thumb" class="background-thumb"></div></div><div class="preset-wrap"><label>أو اختر من القوالب الجاهزة</label><div class="preset-list">${Object.keys(presetMap).map(k=>`<button type="button" class="preset-btn ${(!s.card_background_data&&s.card_background_preset===k)?'selected':''}" data-preset="${k}" style="background:${presetMap[k]}"><span>${k==='midnight'?'MIDNIGHT':k==='ocean'?'OCEAN':k==='purple'?'PURPLE':k==='crimson'?'CRIMSON':'FOREST'}</span></button>`).join('')}</div><button type="button" class="clear-bg" id="clear-bg">× إزالة الصورة المخصصة</button></div></div></section>

      <section class="editor-card"><div class="section-header"><div class="section-icon">♛</div><div><h2>صورة العضو (Avatar)</h2><p>تخصيص شكل ومقاس وإطار صورة العضو.</p></div></div><div class="control-grid four"><button type="button" class="choice-btn active shape" data-shape="circle"><span>●</span><small>دائري</small></button><button type="button" class="choice-btn shape" data-shape="square"><span>■</span><small>مربع</small></button><button type="button" class="choice-btn shape" data-shape="rounded"><span>▣</span><small>مستطيل دائري</small></button><div class="range-box"><label>حجم الصورة <b id="avatar_size_value">${s.card_avatar_size}px</b></label><input id="card_avatar_size" type="range" min="140" max="310" value="${s.card_avatar_size}"></div></div><div class="inline-controls"><label class="switch"><input id="card_avatar_border" type="checkbox" ${Number(s.card_avatar_border_width)>0?'checked':''}><span>إضافة إطار حول الصورة</span></label><label class="color-inline">لون الإطار <input id="card_avatar_border_color" type="color" value="${esc(s.card_avatar_border_color)}"></label><div class="range-box compact"><label>سماكة الإطار <b id="avatar_border_value">${s.card_avatar_border_width}px</b></label><input id="card_avatar_border_width" type="range" min="0" max="18" value="${s.card_avatar_border_width}"></div></div></section>

      <section class="editor-card"><div class="section-header"><div class="section-icon">◈</div><div><h2>ألوان وتنسيق النصوص</h2><p>تحكم كامل فالألوان، الخط، والمحاذاة.</p></div></div><div class="color-grid"><label>لون اسم العضو<input id="card_primary_color" type="color" value="${esc(s.card_primary_color)}"></label><label>لون اسم السيرفر<input id="card_server_color" type="color" value="${esc(s.card_server_color)}"></label><label>لون النص الرئيسي<input id="card_text_color" type="color" value="${esc(s.card_text_color)}"></label><label>لون التدرج الثاني<input id="card_secondary_color" type="color" value="${esc(s.card_secondary_color)}"></label></div><div class="two-grid"><label>نوع الخط<select id="card_font_family"><option ${s.card_font_family==='Arial'?'selected':''}>Arial</option><option ${s.card_font_family==='Verdana'?'selected':''}>Verdana</option><option ${s.card_font_family==='Trebuchet MS'?'selected':''}>Trebuchet MS</option><option ${s.card_font_family==='Georgia'?'selected':''}>Georgia</option><option ${s.card_font_family==='system-ui'?'selected':''}>system-ui</option></select></label><div><label>محاذاة النص</label><div class="segmented"><button type="button" class="align-btn" data-align="left">يسار</button><button type="button" class="align-btn selected" data-align="center">وسط</button><button type="button" class="align-btn" data-align="right">يمين</button></div></div></div></section>

      <section class="editor-card"><div class="section-header"><div class="section-icon">✦</div><div><h2>الإعدادات الإضافية</h2><p>اختار المعلومات اللي تبان فالبطاقة.</p></div></div><div class="toggle-grid"><label class="toggle-row"><input id="card_show_member_count" type="checkbox" ${bool(s.card_show_member_count)?'checked':''}><span>إظهار عدد الأعضاء</span><b>♟</b></label><label class="toggle-row"><input id="card_show_server" type="checkbox" ${bool(s.card_show_server)?'checked':''}><span>إظهار اسم السيرفر</span><b>⌂</b></label><label class="toggle-row"><input id="card_show_join_date" type="checkbox" ${bool(s.card_show_join_date)?'checked':''}><span>إظهار تاريخ الانضمام</span><b>◷</b></label><label class="toggle-row"><input id="welcome_card_enabled" type="checkbox" ${bool(s.welcome_card_enabled)?'checked':''}><span>تفعيل بطاقة الترحيب</span><b>✓</b></label></div><div class="range-box"><label>شفافية الخلفية <b id="overlay_value">${s.card_overlay_opacity}%</b></label><input id="card_overlay_opacity" type="range" min="0" max="85" value="${s.card_overlay_opacity}"></div><label>النص السفلي<input id="card_footer_text" value="${esc(s.card_footer_text)}"></label></section>

      <section class="editor-card" id="general"><div class="section-header"><div class="section-icon">⚙</div><div><h2>رسالة Embed والرسالة الأساسية</h2><p>الإعدادات القديمة بقات متوفرة ومربوطة مع البطاقة.</p></div></div><div class="toggle-grid two"><label class="toggle-row"><input id="welcome_enabled" type="checkbox" ${bool(s.welcome_enabled)?'checked':''}><span>تفعيل رسالة الترحيب</span><b>✓</b></label><label class="toggle-row"><input id="welcome_embed_enabled" type="checkbox" ${bool(s.welcome_embed_enabled)?'checked':''}><span>تفعيل Embed</span><b>◈</b></label></div><div class="two-grid"><label>قناة الترحيب<select id="welcome_channel_id"><option value="">اختار القناة</option>${channels.map(c=>`<option value="${c.id}" ${s.welcome_channel_id===c.id?'selected':''}>#${esc(c.name)}</option>`).join('')}</select></label><label>لون الـEmbed<input id="welcome_embed_color" type="color" value="${/^#[0-9a-f]{6}$/i.test(s.welcome_embed_color)?s.welcome_embed_color:'#5865F2'}"></label></div><label>عنوان الـEmbed<input id="welcome_embed_title" value="${esc(s.welcome_embed_title)}"></label><label>وصف الـEmbed<textarea>${esc(s.welcome_embed_description)}</textarea></label></section>

      <section class="editor-card" id="auto-role"><div class="section-header"><div class="section-icon">♟</div><div><h2>الرتبة التلقائية</h2><p>يعطي العضو رتبة مباشرة بعد الدخول.</p></div></div><label>الرتبة<select id="auto_role_id"><option value="">بدون رتبة</option>${roles.map(r=>`<option value="${r.id}" ${s.auto_role_id===r.id?'selected':''}>@${esc(r.name)}</option>`).join('')}</select></label><div class="hint-box">⚠️ خاص رتبة البوت تكون فوق الرتبة اللي باغي يعطيها.</div></section>

      <section class="editor-card" id="leave"><div class="section-header"><div class="section-icon">↪</div><div><h2>رسالة المغادرة</h2><p>نفس النظام ولكن للأعضاء اللي كيخرجو من السيرفر.</p></div></div><label class="switch"><input id="leave_enabled" type="checkbox" ${bool(s.leave_enabled)?'checked':''}><span>تفعيل رسالة المغادرة</span></label><div class="two-grid"><label>القناة<select id="leave_channel_id"><option value="">اختار القناة</option>${channels.map(c=>`<option value="${c.id}" ${s.leave_channel_id===c.id?'selected':''}>#${esc(c.name)}</option>`).join('')}</select></label></div><label>الرسالة<textarea id="leave_message">${esc(s.leave_message)}</textarea></label></section>

      <section class="editor-card save-template"><div><h2>حفظ وتنسيق القالب</h2><p>تقدر تعدل القيم ومن بعد تحفظها مباشرة.</p></div><div class="template-actions"><button type="button" class="secondary" id="reset-template">↺ استرجاع الإعدادات</button><button type="button" class="primary" id="save-bottom">▣ حفظ كقالب</button></div></section>
    </div>

    <aside class="preview-column"><section class="preview-panel"><div class="preview-header"><div><h2>معاينة البطاقة</h2><p>هكذا غادي تظهر بطاقة الترحيب للأعضاء.</p></div><span class="live-badge">● LIVE</span></div><div class="preview-stage"><div id="card-preview" class="welcome-preview"></div></div><div class="preview-info"><h3>معلومات إضافية عن البطاقة</h3><div><span>اسم العضو</span><b><%= user.global_name || user.username %></b></div><div><span>اسم السيرفر</span><b id="preview-server-name">${esc(d.guild.name)}</b></div><div><span>عدد الأعضاء</span><b>${d.guild.memberCount}</b></div></div><div class="tip-box">💡 <div><b>نصيحة</b><p>المعاينة كتتبدل مباشرة. الصورة النهائية اللي كيرسلها البوت كتكون بنفس الإعدادات.</p></div></div></section></aside>
  </div>`;

  document.querySelectorAll('.shape').forEach(b=>{b.classList.toggle('active',b.dataset.shape===s.card_avatar_shape);b.onclick=()=>{document.querySelectorAll('.shape').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById('card_avatar_shape').value=b.dataset.shape;renderPreview();};});
  const hidden=document.createElement('input');hidden.type='hidden';hidden.id='card_avatar_shape';hidden.value=s.card_avatar_shape;$('#editor').appendChild(hidden);
  document.querySelectorAll('.align-btn').forEach(b=>{b.classList.toggle('selected',b.dataset.align===s.card_text_align);b.onclick=()=>{document.querySelectorAll('.align-btn').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');const v=document.getElementById('card_text_align');v.value=b.dataset.align;renderPreview();};});
  const alignHidden=document.createElement('input');alignHidden.type='hidden';alignHidden.id='card_text_align';alignHidden.value=s.card_text_align;$('#editor').appendChild(alignHidden);

  const thumb=$('#background-thumb');
  if(backgroundData) thumb.innerHTML=`<div class="thumb-preview" style="background-image:url('${backgroundData}')"><button type="button" id="remove-thumb">×</button></div>`;
  $('#upload-btn').onclick=()=>$('#card_background_file').click();
  $('#card_background_file').onchange=async e=>{const file=e.target.files?.[0];if(!file)return;if(file.size>2*1024*1024)return alert('الصورة خاصها تكون أقل من 2MB.');const data=await resizeImage(file);backgroundData=data;thumb.innerHTML=`<div class="thumb-preview" style="background-image:url('${data}')"><button type="button" id="remove-thumb">×</button></div>`;bindRemoveThumb();renderPreview();};
  function bindRemoveThumb(){const b=$('#remove-thumb');if(b)b.onclick=()=>{backgroundData=null;thumb.innerHTML='<span>ما كايناش صورة مخصصة</span>';renderPreview();};}
  bindRemoveThumb();
  $('#clear-bg').onclick=()=>{backgroundData=null;thumb.innerHTML='<span>ما كايناش صورة مخصصة</span>';renderPreview();};
  $('#save').onclick=save;
  $('#save-bottom').onclick=save;
  $('#live').onclick=()=>$('#card-preview').scrollIntoView({behavior:'smooth',block:'center'});
  $('#reset-template').onclick=()=>{if(confirm('واش متأكد تبغي ترجع الإعدادات الافتراضية؟')){document.getElementById('welcome_card_text').value='WELCOME';document.getElementById('welcome_card_subtext').value='{username}';document.getElementById('card_primary_color').value='#5865F2';document.getElementById('card_secondary_color').value='#8B5CF6';document.getElementById('card_text_color').value='#FFFFFF';document.getElementById('card_server_color').value='#C7D2FE';document.getElementById('card_avatar_size').value=230;document.getElementById('card_avatar_border_width').value=6;document.getElementById('card_overlay_opacity').value=35;document.getElementById('card_footer_text').value='Together We Are Stronger';backgroundData=null;renderPreview();}};
  bindLivePreview(); renderPreview();
}

async function resizeImage(file){
  const src=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file);});
  const img=await new Promise((resolve,reject)=>{const i=new Image();i.onload=()=>resolve(i);i.onerror=reject;i.src=src;});
  const max=1400;const ratio=Math.min(1,max/Math.max(img.width,img.height));const c=document.createElement('canvas');c.width=Math.max(1,Math.round(img.width*ratio));c.height=Math.max(1,Math.round(img.height*ratio));c.getContext('2d').drawImage(img,0,0,c.width,c.height);return c.toDataURL('image/jpeg',0.82);
}

async function selectGuild(id){selected=id;loadGuilds();try{const d=await json('/api/guilds/'+id);currentGuild=d;createEditor(d);}catch(e){alert(e.message);}}

async function save(){
  const get=id=>document.getElementById(id), val=id=>get(id)?.value || '', checked=id=>Boolean(get(id)?.checked);
  const body={
    welcome_enabled:checked('welcome_enabled'), welcome_channel_id:val('welcome_channel_id'), welcome_message:val('welcome_message'),
    welcome_embed_enabled:checked('welcome_embed_enabled'), welcome_embed_title:val('welcome_embed_title'),
    welcome_embed_description:(document.querySelector('#editor textarea')?.value || ''), welcome_embed_color:val('welcome_embed_color'),
    welcome_card_enabled:checked('welcome_card_enabled'), welcome_card_text:val('welcome_card_text'), welcome_card_subtext:val('welcome_card_subtext'),
    card_background_data:backgroundData, card_background_preset:val('card_background_preset') || 'midnight',
    card_primary_color:val('card_primary_color'), card_secondary_color:val('card_secondary_color'), card_text_color:val('card_text_color'),
    card_server_color:val('card_server_color'), card_avatar_shape:val('card_avatar_shape'), card_avatar_size:Number(val('card_avatar_size')||230),
    card_avatar_border_color:val('card_avatar_border_color'), card_avatar_border_width:Number(val('card_avatar_border_width')||0),
    card_overlay_opacity:Number(val('card_overlay_opacity')||35), card_font_family:val('card_font_family'), card_text_align:val('card_text_align'),
    card_footer_text:val('card_footer_text'), card_show_member_count:checked('card_show_member_count'), card_show_server:checked('card_show_server'), card_show_join_date:checked('card_show_join_date'),
    auto_role_id:val('auto_role_id'), leave_enabled:checked('leave_enabled'), leave_channel_id:val('leave_channel_id'), leave_message:val('leave_message')
  };
  const b=$('#save'); if(!b)return; b.disabled=true;b.textContent='جاري الحفظ...';
  try{const out=await json('/api/guilds/'+selected+'/settings',{method:'POST',headers:{'content-type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify(body)});currentGuild.settings=out.settings;b.textContent='تم الحفظ ✓';setTimeout(()=>{b.textContent='↻ حفظ التغييرات';b.disabled=false;},1400);}catch(e){alert(e.message);b.disabled=false;b.textContent='↻ حفظ التغييرات';}
}

loadGuilds();
</script>
